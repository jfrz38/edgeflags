{
  "name": "@edgeflags/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "architecture": "clean-arch check . --source-folder src --config clean-architecture.json",
    "dev": "pnpm run generate-types && wrangler dev",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "generate-types": "wrangler types",
    "lint": "biome lint .",
    "prepare": "cd .. && husky",
    "test": "vitest run",
    "typecheck": "pnpm run generate-types && tsc --noEmit && tsc --noEmit --project test/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "1.3.3",
    "@jfrz38/clean-architecture-highlighter-cli": "0.1.0",
    "@types/node": "24.19.0",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
